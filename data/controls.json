				["Mouse", "Menus, tabs and buttons at a port"]
			]
		},
		{
			"name": "Flying an approach",
			"when": "from arrival to docking",
			"keys": [
				["W  /  S", "Thrust forward / back"],
				["A  /  D", "Strafe left / right"],
				["R  /  F", "Strafe up / down"],
				["Shift", "Boost (hold)"],
				["X", "Brake (hold)"],
				["Arrows", "Pitch and yaw"],
				["Q  /  E", "Roll left / right"],
				["Z", "Flight assist: full, assisted, manual"],
				["V", "Spin match: roll with the station"],
				["G", "Scanner range"],
				["C", "Cockpit or chase view"],
